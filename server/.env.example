# Generate server/.env with: uv run python -m app.cli init-env
SONAR_DATA_DIR=./data
SONAR_ALICE_TOKEN=
SONAR_BOB_TOKEN=
SONAR_ALICE_DEVICE_ID=device_alice_demo
SONAR_BOB_DEVICE_ID=device_bob_demo
SONAR_ALICE_AGENT_ID=
SONAR_BOB_AGENT_ID=
SONAR_MCP_ENABLED=false
SONAR_MCP_SECRET=
SONAR_QUESTION_TTL=120
SONAR_INVITATION_TTL=90
SONAR_PRESENCE_TTL=600
SONAR_AUDIO_TTL=86400
# Dynamic published information lasts until 24:00 Asia/Shanghai; standing notices stay permanent.
SONAR_INFORMATION_VALID_UNTIL_DAY_END=true
# AMap Web Service key (server only). Blank -> location/POI endpoint returns 503.
SONAR_AMAP_KEY=
SONAR_LOCATION_TTL=60
SONAR_LOCATION_ACCURACY_M=100
SONAR_NEARBY_RADIUS_M=300
# Test emulator locations are ineligible by default. Enable only in isolated tests.
SONAR_ALLOW_MOCK_LOCATION=false
# Optional operator pin for an explicitly authorized live hardware simulation.
# Mobile point selections use the dedicated API and supersede this temporary pin.
SONAR_REMOTE_PLACE_USERS={}
# Personal invitation filtering. Enable with Bamboo configured.
SONAR_BAMBOO_API_KEY=
SONAR_BAMBOO_BASE_URL=https://api.bamboonode.dev/v1
SONAR_DECISION_ENABLED=false
SONAR_DECISION_TIMEOUT=4.5
# Foreground place voices: provisional pilot configuration, not field-validated thresholds.
SONAR_VOICE_RADIUS_M=150
SONAR_VISIT_EXIT_GRACE=120
SONAR_SCENE_PROMPT_LIMIT=1
SONAR_SCENE_PROMPT_INTERVAL=300
SONAR_OBSERVATION_MAX_TTL=3600
SONAR_ANNOUNCEMENT_MAX_TTL=86400

# Explicitly opted-in natural exchange. Uses Bamboo independently of legacy invitation filtering.
# Missing Bamboo key refuses a new exchange session; no model failure auto-publishes.
SONAR_EXCHANGE_SESSION_TTL=3600
SONAR_EXCHANGE_TURN_TTL=180
SONAR_EXCHANGE_DECISION_TIMEOUT=20
SONAR_EXCHANGE_LISTEN_CONFIDENCE=0.65
SONAR_EXCHANGE_OBSERVATION_TTL=300
# Only after verifying these Linx agent IDs have no mutating cloud tools.
# Empty refuses client-managed speculative voice; existing credentials stay separate.
SONAR_MANAGED_VOICE_VERIFIED_AGENTS=[]
